# CafeSync Platform Master App Environment Variables

# Public Supabase API (Required for authentication and database queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key (Platform master privileges for brand provisioning and auth user management)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URLs (for cross-app linking)
NEXT_PUBLIC_SHOP_APP_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
NEXT_PUBLIC_MASTER_APP_URL=http://localhost:3000

