# CafeSync Shop App Environment Variables

# Public Supabase API (Required for authentication and database queries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App URLs (for cross-app linking)
NEXT_PUBLIC_SHOP_APP_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
NEXT_PUBLIC_MASTER_APP_URL=http://localhost:3000

